  "name": "Frequently Asked Questions — Westchester Cleaning Services",
  "url": "https://www.westchestercleanings.com/faq",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "Is Westchester Cleaning Services insured?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes. Westchester Cleaning Services, LLC is fully insured. We carry comprehensive liability insurance to protect your property and our employees. Certificates of insurance are available upon request."
      }
    },
    {
      "@type": "Question",
      "name": "What areas does Westchester Cleaning Services serve?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "We serve all of Westchester County, NY, including White Plains, Yonkers, New Rochelle, Mount Vernon, Tarrytown, Scarsdale, Rye, Mamaroneck, Ossining, Peekskill, Port Chester, and surrounding communities."
      }
    },
    {
      "@type": "Question",
      "name": "What commercial cleaning services do you offer?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "We offer janitorial services, office cleaning, post-construction cleaning, multi-family building and condo/co-op cleaning, strip and wax floor care, specialty cleaning (including disinfection and event cleaning), and porter services."
      }
    },
    {
      "@type": "Question",
      "name": "How do I get a quote for commercial cleaning?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "You can request a free quote at https://www.westchestercleanings.com/commercial-pricing, call us at (914) 357-5780, or email info@westchestercleanings.com. We begin with a consultation to understand your needs, then create a customized cleaning plan."
      }
    },
    {
      "@type": "Question",
      "name": "How do you handle recurring cleaning schedules?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "We offer flexible recurring schedules — daily, weekly, or monthly — tailored to your business needs. Our software automatically sends email reminders two days and one day before each scheduled cleaning."
      }
    },
    {
      "@type": "Question",
      "name": "What payment methods do you accept?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "We accept credit/debit cards, checks, bank transfers, Apple Pay, and Bitcoin. For commercial clients, invoices are sent monthly with payment due within 30 days."
      }
    },
    {
      "@type": "Question",
      "name": "Do you provide cleaning supplies and equipment?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes, we provide all necessary cleaning supplies and equipment. We can accommodate specific product preferences upon request and offer eco-friendly green cleaning options."
      }
    },
    {
      "@type": "Question",
      "name": "What is your cancellation policy?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "You have 48 hours before your scheduled cleaning to reschedule or cancel at no charge. Changes made with less than 48 hours notice incur a 30% cancellation fee."
      }
    },
    {
      "@type": "Question",
      "name": "Is Westchester Cleaning Services MBE certified?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes. Westchester Cleaning Services, LLC is a certified Minority Business Enterprise (MBE) through the New York State Empire State Development MWBE program."
      }
    },
    {
      "@type": "Question",
      "name": "What is your response time for emergency cleaning?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Our response time for emergency cleaning requests is typically within 2 hours. We have a dedicated team available for urgent cleaning needs."
      }
    },
    {
      "@type": "Question",
      "name": "Do you offer post-construction cleaning in Westchester?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes. We offer comprehensive post-construction cleaning services across Westchester County to remove dust, debris, and construction residue so your property is clean and ready for occupancy."
      }
    },
    {
      "@type": "Question",
      "name": "Can you clean condo and co-op buildings?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes. We specialize in multi-family building cleaning including condominiums and co-ops. We work directly with property managers and board members to create customized cleaning plans."
      }
    }
